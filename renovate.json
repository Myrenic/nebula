{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies", "renovate"],
  "enabledManagers": ["flux", "kubernetes", "github-actions"],
  "flux": {
    "fileMatch": ["kubernetes/.+\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["kubernetes/.+\\.yaml$"]
  },
  "prCreation": "immediate",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "Automerge safe IaC updates (non-major)",
      "matchManagers": ["flux", "kubernetes", "github-actions"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Vendored upstream operator bundles must move as a whole (image tag + CRDs + KUBEVIRT_VERSION env), so never automerge image bumps inside them",
      "matchFileNames": [
        "kubernetes/apps/kubevirt/operator/base/operator.yaml",
        "kubernetes/apps/kubevirt/cdi/base/operator.yaml",
        "kubernetes/apps/network/traefik-crds/crds.yaml"
      ],
      "automerge": false,
      "labels": ["dependencies", "renovate", "manual-upgrade"]
    }
  ]
}

{
  "apps": [
    {
      "id": "ubuntu-desktop",
      "name": "Ubuntu Desktop",
      "description": "Full KDE Plasma desktop (Wayland).",
      "type": "desktop",
      "icon": "🐧",
      "image": "ghcr.io/linuxserver/webtop:ubuntu-kde",
      "env": [
        { "name": "PIXELFLUX_WAYLAND", "value": "true" }
      ],
      "users": ["test@chacdn.local"]
    },
    {
      "id": "firefox",
      "name": "Firefox",
      "description": "Mozilla Firefox in a single-app container.",
      "type": "app",
      "icon": "🦊",
      "image": "ghcr.io/linuxserver/firefox:latest",
      "env": [
        { "name": "PIXELFLUX_WAYLAND", "value": "true" },
        { "name": "RESTART_APP", "value": "true" }
      ],
      "users": ["test@chacdn.local"]
    }
  ]
}